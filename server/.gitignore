# =========================
# Node.js + TypeScript Server
# =========================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# dotenv environment variables
.env
.env.*.local

# Node modules
node_modules/

# Dist / Build output
dist/
build/
out/

# TypeScript cache
*.tsbuildinfo

# Coverage reports
coverage/
*.lcov

# Temporary files
tmp/
temp/

# IDE / Editor settings
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS specific files
.DS_Store
Thumbs.db

# Debug logs
*.stackdump

# Yarn / NPM / PNPM caches
.yarn/
.yarnrc
.yarn-error.log
.pnp.*
.pnpm-debug.log
package-lock.json
yarn.lock

# Azure / Uploads / Files
uploads/
storage/

# Logs generated by PM2 / nodemon
.pm2/
nodemon-debug.log

# Optional: Ignore test results
test-results/
jest-report/
jest-html-reporters-*

# VS Code workspace storage
.vscode-test/
.history/

# Local database files
*.db
*.sqlite
*.sqlite3

# Ignore compiled JS from TypeScript
**/*.js
**/*.js.map

# Ignore Azure SAS tokens if generated locally
sas-tokens.json

# Ignore environment-specific config files
config/local.json
config/*.local.json

# Misc
*.tgz
*.tar
*.zip
*.7z
